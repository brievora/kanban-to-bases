{
  "name": "kanban-to-bases",
  "version": "1.0.1",
  "description": "Convert boards from the community Kanban plugin into notes and a Bases file shown in the native Kanban view.",
  "private": true,
  "license": "MIT",
  "author": "Brievora",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  }
}
